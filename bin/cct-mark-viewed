#!/usr/bin/env bash
# Append a focus-in record for a pane. Called by tmux pane-focus-in hook
# and by the picker on Enter (switch-to-pane).
set -u
set +e
pane="${1:-${TMUX_PANE:-}}"
[ -z "$pane" ] && exit 0
STATE_DIR="${CLAUDE_TMUX_STATE_DIR:-$HOME/.claude-tmux}"
mkdir -p "$STATE_DIR" 2>/dev/null
TS="$(perl -MTime::HiRes=time -e 'print int(time()*1000)' 2>/dev/null || date +%s)"
printf '{"ts":%s,"pane_id":"%s"}\n' "$TS" "$pane" >> "$STATE_DIR/viewed.jsonl"
exit 0
